// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../apps/mirapay-backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // ex: ADMIN, CUSTOMER, SUPPORT
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id          String    @id @default(uuid())
  username    String    @unique
  email       String    @unique
  password    String // Sera encrypté (hash) avant sauvegarde
  firstName   String
  lastName    String
  phoneNumber String?
  dateOfBirth DateTime?
  address     String?
  city        String?
  country     String?
  isActive    Boolean   @default(true)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  timeEntries  TimeEntry[]
  taskNotes    TaskNote[]
}

model Client {
  id              String  @id @default(uuid())
  typeClient      String // entreprise | particulier
  nomLegal        String
  adresseLigne1   String
  adresseLigne2   String?
  ville           String
  province        String
  codePostal      String
  pays            String
  courriel        String
  telephone       String
  contactNom      String? // pour entreprise
  contactFonction String?
  notesInternes   String? @db.Text

  modeFacturationParDefaut String // horaire | forfait | banqueHeures | nonFacturable
  deviseParDefaut          String  @default("CAD")
  conditionsPaiement       String?
  modesPaiement            String? // Interac, virement, etc.

  clientTaxable Boolean @default(true)
  appliquerTPS  Boolean @default(true)
  appliquerTVQ  Boolean @default(true)
  estArchive    Boolean @default(false)

  projects    Project[]
  invoices    Invoice[]
  bankHours   BankHour[]
  contacts    Contact[]
  soumissions Soumission[]
  contrats    Contrat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id            String    @id @default(uuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  nom           String
  description   String?   @db.Text
  dateDebut     DateTime
  dateFinPrevue DateTime?
  statut        String    @default("brouillon") // brouillon | enCours | enPause | termine | facture | archive

  typeFacturation        String // horaire | forfait | banqueHeures
  tauxHoraire            Float?
  montantForfait         Float?
  heuresBanqueTotales    Float?
  heuresBanqueConsommees Float  @default(0)
  budgetHeuresPrevu      Float?
  budgetMontantPrevu     Float?
  arrondiHeures          Float? // 0.25 | 0.5 | 1

  tasks        Task[]
  timeEntries  TimeEntry[]
  invoiceLines InvoiceLine[]
  bankHours    BankHour[]
  contratId    String?
  contrat      Contrat?      @relation(fields: [contratId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id              String    @id @default(uuid())
  projetId        String
  projet          Project   @relation(fields: [projetId], references: [id])
  titre           String
  description     String?   @db.Text
  type            String // analyse, développement, réunion, support, etc.
  tacheFacturable Boolean   @default(true)
  priorite        String    @default("normale") // basse | normale | haute
  statut          String    @default("new") // new | analyse | en_cours | terminer | fermer
  dateDebutPrevue DateTime?
  dateEcheance    DateTime?

  timeEntries TimeEntry[]
  notes       TaskNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskNote {
  id        String   @id @default(uuid())
  tacheId   String
  tache     Task     @relation(fields: [tacheId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  contenu   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimeEntry {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime
  projetId      String
  projet        Project  @relation(fields: [projetId], references: [id])
  tacheId       String?
  tache         Task?    @relation(fields: [tacheId], references: [id])
  dureeHeures   Float
  estFacturable Boolean  @default(true)
  commentaire   String?  @db.Text
  statut        String   @default("brouillon") // brouillon | approuve | facture

  invoiceLines InvoiceLine[] @relation("InvoiceLineTimeEntries")
  bankHourId   String?
  bankHour     BankHour?     @relation(fields: [bankHourId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id                 String   @id @default(uuid())
  numero             String   @unique // numérotation séquentielle
  dateFacture        DateTime @default(now())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id])
  projetId           String? // optionnel si multi-projets
  statut             String   @default("brouillon") // brouillon | envoyee | payee | enRetard | annulee
  sousTotal          Float    @default(0)
  montantTPS         Float    @default(0)
  montantTVQ         Float    @default(0)
  totalTTC           Float    @default(0)
  conditionsPaiement String?

  lines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceLine {
  id           String   @id @default(uuid())
  factureId    String
  facture      Invoice  @relation(fields: [factureId], references: [id])
  projetId     String?
  projet       Project? @relation(fields: [projetId], references: [id])
  description  String   @db.Text
  quantite     Float // ex. heures
  prixUnitaire Float
  montantLigne Float // calculé quantite * prixUnitaire

  timeEntries TimeEntry[] @relation("InvoiceLineTimeEntries")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id        String   @id @default(uuid())
  amount    Float
  currency  String
  status    String // PENDING, COMPLETED, FAILED
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model BankHour {
  id               String    @id @default(uuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id])
  projetId         String?
  projet           Project?  @relation(fields: [projetId], references: [id])
  nom              String
  description      String?   @db.Text
  heuresAchetees   Float
  heuresConsommees Float     @default(0)
  dateDebut        DateTime?
  dateFin          DateTime?
  estActive        Boolean   @default(true)

  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id        String  @id @default(uuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  nom       String
  fonction  String?
  courriel  String?
  telephone String?
  estActive Boolean @default(true)

  soumissions Soumission[]
  contrats    Contrat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Soumission {
  id             String    @id @default(uuid())
  numero         String    @unique
  dateSoumission DateTime  @default(now())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id])
  titre          String
  description    String?   @db.Text
  dateValidite   DateTime?
  statut         String    @default("brouillon") // brouillon | envoyee | acceptee | refusee | expiree
  sousTotalHT    Float     @default(0)
  montantTPS     Float     @default(0)
  montantTVQ     Float     @default(0)
  totalTTC       Float     @default(0)

  lines    SoumissionLine[]
  contrats Contrat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SoumissionLine {
  id           String     @id @default(uuid())
  soumissionId String
  soumission   Soumission @relation(fields: [soumissionId], references: [id])
  description  String     @db.Text
  quantite     Float
  prixUnitaire Float
  montantLigne Float // quantite * prixUnitaire
  typeLigne    String // service | materiel | autre

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contrat {
  id                  String      @id @default(uuid())
  numero              String      @unique
  dateSignature       DateTime?
  dateDebut           DateTime
  dateFin             DateTime?
  clientId            String
  client              Client      @relation(fields: [clientId], references: [id])
  contactId           String?
  contact             Contact?    @relation(fields: [contactId], references: [id])
  soumissionId        String?
  soumission          Soumission? @relation(fields: [soumissionId], references: [id])
  statut              String      @default("actif") // actif | suspendu | termine | archive
  montantTotalContrat Float?
  typeContrat         String // horaire | forfait | banqueHeures | mixte
  conditionsSpeciales String?     @db.Text

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
