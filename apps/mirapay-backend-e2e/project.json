{
  "name": "mirapay-backend-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["mirapay-backend"],
  "targets": {
    "e2e": {
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}",
        "{workspaceRoot}/coverage/mirapay-backend-e2e"
      ],
      "dependsOn": ["mirapay-backend:build", "mirapay-backend:serve"],
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
