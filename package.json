{
  "name": "@mirapay/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "concurrently \"npm run start:back\" \"npm run start:front\"",
    "start:front": "nx serve mirapay-frontend",
    "start:back": "nx serve mirapay-backend",
    "build:shared": "nx run shared-models:build",
    "build:back": "nx run shared-models:build && nx serve mirapay-backend",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "clean:build": "npm run clean && nx run shared-models:build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "nx run-many -t test",
    "e2e": "nx run-many -t e2e"
  },
  "private": true,
